# Application Configuration
PROJECT_NAME="FlowForge"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Security
SECRET_KEY="change_me_to_a_very_long_and_secure_random_string_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database
# For local dev without Postgres, SQLite async can be used: sqlite+aiosqlite:///./flowforge.db
# For Docker / production: postgresql+asyncpg://postgres:postgres@postgres:5432/flowforge
DATABASE_URL="sqlite+aiosqlite:///./flowforge.db"

# Redis & Queue
# For Docker / production: redis://redis:6379/0
# If empty or unavailable, FlowForge falls back gracefully to in-memory queue for dev/tests
REDIS_URL="redis://localhost:6379/0"
USE_REDIS_QUEUE=false

# Worker settings
WORKER_CONCURRENCY=5
EXECUTION_TIMEOUT_SECONDS=60
MAX_STEP_RETRIES=3

# Scheduler
SCHEDULER_CHECK_INTERVAL_SECONDS=10

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
